---
interface Props {
  title: string
  href?: string
  linkText?: string
}
const { title, href, linkText } = Astro.props
---

<div class="mt-12 mb-4 flex items-baseline justify-between gap-4">
  <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{title}</h2>
  {href && <a href={href} class="font-medium whitespace-nowrap text-primary-500 hover:text-primary-400">{linkText} →</a>}
</div>
