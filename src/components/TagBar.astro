---
import Chip from './Chip.astro'
import { getPosts, getTags } from '../lib/posts'
interface Props {
  active?: string
}
const { active } = Astro.props
const posts = await getPosts()
const tags = getTags(posts)
---

<nav aria-label="Filter by craft" class="mt-6 mb-8 flex flex-wrap gap-2">
  <Chip href="/projects/" count={posts.length} active={!active}>All</Chip>
  {tags.map((t) => <Chip href={`/tags/${t.slug}/`} count={t.count} active={t.slug === active}>{t.name}</Chip>)}
</nav>
