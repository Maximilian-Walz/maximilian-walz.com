---
import Tag from './Tag.astro'
import { getPosts, getTags } from '../lib/posts'
interface Props {
  active?: string
}
const { active } = Astro.props
const posts = await getPosts()
const tags = getTags(posts)
---

<nav aria-label="Filter by craft" class="mt-4 mb-8 flex flex-wrap gap-2">
  <Tag name="All" href="/projects/" count={posts.length} active={!active} />
  {tags.map((t) => <Tag name={t.name} count={t.count} active={t.slug === active} />)}
</nav>
