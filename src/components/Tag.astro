---
import { tagSlug } from '../lib/posts'
interface Props {
  name: string
  href?: string
  count?: number
  active?: boolean
}
const { name, href = `/tags/${tagSlug(name)}/`, count, active = true } = Astro.props
---

<a
  href={href}
  class:list={[
    'rounded-full px-2.5 py-0.5 text-xs font-medium whitespace-nowrap',
    active
      ? 'bg-primary-700 text-primary-400 hover:text-primary-300'
      : 'bg-primary-900 text-primary-500 hover:text-primary-400',
  ]}
>
  {name}{count !== undefined && ` (${count})`}
</a>
