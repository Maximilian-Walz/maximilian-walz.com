---
import { tagSlug } from '../lib/posts'
interface Props {
  name: string
  /** Render as plain text, for use inside another link. */
  plain?: boolean
}
const { name, plain = false } = Astro.props
const cls = 'text-xs font-semibold tracking-wider whitespace-nowrap text-primary-400 uppercase'
---

{plain ? <span class={cls}>{name}</span> : <a href={`/tags/${tagSlug(name)}/`} class:list={[cls, 'hover:text-primary-200']}>{name}</a>}
