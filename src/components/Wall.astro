---
// A photo wall: every cover in its own proportions, title and craft on hover (always visible on touch screens).
import { Image } from 'astro:assets'
import Tag from './Tag.astro'
import type { Post } from '../lib/posts'
interface Props {
  posts: Post[]
}
const { posts } = Astro.props
---

<div class="columns-1 gap-5 sm:columns-2 lg:columns-3">
  {
    posts.map((p, i) => (
      <a href={`/projects/${p.id}/`} class="wall-tile group relative mb-5 block break-inside-avoid overflow-hidden rounded-xl">
        <Image
          src={p.cover}
          alt={p.data.title}
          widths={[400, 640, 960]}
          sizes="(min-width: 64rem) 23rem, (min-width: 40rem) 50vw, 100vw"
          loading={i < 3 ? 'eager' : 'lazy'}
          class="h-auto w-full transition-transform duration-500 group-hover:scale-105"
          style={`view-transition-name: cover-${p.id}`}
        />
        <span class="caption absolute inset-x-0 bottom-0 flex flex-col gap-1 bg-gradient-to-t from-gray-950/95 via-gray-950/60 to-transparent p-4 pt-14">
          <span class="text-xl leading-6 font-bold tracking-tight">{p.data.title}</span>
          <span class="flex flex-wrap gap-x-3">{p.data.tags.map((t) => <Tag name={t} plain />)}</span>
        </span>
      </a>
    ))
  }
</div>
