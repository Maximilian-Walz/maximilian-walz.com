---
import { site } from '../lib/posts'
const year = new Date().getFullYear()
---

<footer class="mt-20 flex flex-col items-center justify-between gap-4 border-t border-gray-800 py-8 text-sm text-gray-400 sm:flex-row">
  <div class="flex gap-2">
    <span>© {year} {site.title}</span>
    <span>·</span>
    <a class="hover:text-primary-400" href="/legal/">Legal</a>
  </div>
  <div class="flex gap-5">
    <a class="hover:text-primary-400" href={`mailto:${site.email}`}>Mail</a>
    <a class="hover:text-primary-400" href={site.github} rel="me">GitHub</a>
    <a class="hover:text-primary-400" href={site.reddit} rel="me">Reddit</a>
    <a class="hover:text-primary-400" href="/feed.xml">RSS</a>
  </div>
</footer>
