---
import Icon from './Icon.astro'
import { site } from '../lib/posts'
const year = new Date().getFullYear()
const links = [
  { name: 'mail', label: 'Mail', href: `mailto:${site.email}` },
  { name: 'github', label: 'GitHub', href: site.github },
  { name: 'reddit', label: 'Reddit', href: site.reddit },
  { name: 'rss', label: 'RSS feed', href: '/feed.xml' },
] as const
---

<footer class="mt-20 flex flex-col items-center gap-4 border-t border-gray-900 py-8 text-sm text-gray-400">
  <div class="flex gap-5">
    {
      links.map((l) => (
        <a href={l.href} aria-label={l.label} title={l.label} rel={l.name === 'github' || l.name === 'reddit' ? 'me' : undefined} class="text-gray-300 transition-colors hover:text-primary-400">
          <Icon name={l.name} />
        </a>
      ))
    }
  </div>
  <div class="flex gap-2">
    <span>© {year} {site.title}</span>
    <span>·</span>
    <a class="hover:text-primary-400" href="/legal/">Legal</a>
  </div>
</footer>
