---
interface Props {
  href: string
  active?: boolean
  count?: number
}
const { href, active = false, count } = Astro.props
---

<a
  href={href}
  aria-current={active ? 'page' : undefined}
  class:list={[
    'rounded-full border px-3.5 py-1.5 text-sm whitespace-nowrap transition-colors',
    active
      ? 'border-primary-500 bg-primary-500 font-semibold text-gray-950'
      : 'border-gray-700 text-gray-200 hover:border-primary-500 hover:text-primary-400',
  ]}
>
  <slot />{count !== undefined && <span class:list={['ml-1.5', active ? 'text-gray-800' : 'text-gray-500']}>{count}</span>}
</a>
