---
// A cropped tile with the title over the image. Used in the homepage grid.
import { Image } from 'astro:assets'
import Tag from './Tag.astro'
import type { Post } from '../lib/posts'

interface Props {
  post: Post
  /** Large tiles also show the summary. */
  big?: boolean
  eager?: boolean
  label?: string
  sizes?: string
}
const { post, big = false, eager = false, label, sizes = '(min-width: 40rem) 23rem, 100vw' } = Astro.props
const href = `/projects/${post.id}/`
---

<article class="group relative h-full overflow-hidden rounded-xl">
  <a href={href} tabindex="-1" aria-hidden="true" class="block h-full">
    <Image
      src={post.cover}
      alt=""
      widths={[400, 640, 960, 1280]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      style={`view-transition-name: cover-${post.id}`}
    />
  </a>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-gray-950/95 via-gray-950/60 to-transparent p-4 pt-16">
    {label && <p class="mb-1 text-xs font-semibold tracking-wider text-gray-300 uppercase">{label}</p>}
    <h3 class:list={['font-bold tracking-tight', big ? 'text-2xl sm:text-3xl' : 'text-xl leading-6']}>
      <a href={href} class="pointer-events-auto hover:text-primary-400">{post.data.title}</a>
    </h3>
    {big && post.data.summary && <p class="mt-1 line-clamp-2 text-gray-200">{post.data.summary}</p>}
    <div class="pointer-events-auto mt-2 flex flex-wrap gap-x-3">
      {post.data.tags.map((t) => <Tag name={t} />)}
    </div>
  </div>
</article>
