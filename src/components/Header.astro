---
import logo from '../assets/logo.svg?raw'
import { site } from '../lib/posts'

const links = [
  { href: '/projects/', title: 'Projects' },
  { href: '/about/', title: 'About' },
]
const path = Astro.url.pathname
---

<header class="flex items-center justify-between py-3 md:py-5">
  <a href="/" aria-label={`${site.title}, home`} class="flex items-center gap-3">
    <span class="logo block w-14" set:html={logo} />
    <span class="hidden text-2xl font-semibold sm:block">{site.title}</span>
  </a>
  <nav class="flex items-center gap-5 leading-5 sm:gap-6">
    {
      links.map((l) => (
        <a
          href={l.href}
          aria-current={path.startsWith(l.href) ? 'page' : undefined}
          class="font-medium text-gray-100 underline-offset-4 hover:text-primary-400 aria-[current=page]:underline"
        >
          {l.title}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .logo :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
