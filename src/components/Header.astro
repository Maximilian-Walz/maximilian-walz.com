---
import logo from '../assets/logo.svg?raw'
import { site } from '../lib/posts'

const links = [
  { href: '/projects/', title: 'Projects' },
  { href: '/about/', title: 'About' },
]
const path = Astro.url.pathname
---

<header class="sticky top-0 z-20 -mx-4 flex items-center justify-between bg-gray-950/85 px-4 py-3 backdrop-blur-md sm:-mx-6 sm:px-6 md:py-4">
  <a href="/" aria-label={`${site.title}, home`} class="flex items-center gap-3">
    <span class="logo block w-12" set:html={logo} />
    <span class="hidden text-xl font-semibold tracking-tight sm:block">{site.title}</span>
  </a>
  <nav class="flex items-center gap-1">
    {
      links.map((l) => (
        <a
          href={l.href}
          aria-current={path.startsWith(l.href) ? 'page' : undefined}
          class="rounded-full px-3 py-1.5 text-sm font-medium text-gray-200 hover:text-primary-400 aria-[current=page]:bg-gray-800 aria-[current=page]:text-white"
        >
          {l.title}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .logo :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
