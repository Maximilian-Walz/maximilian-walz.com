---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import Card from '../components/Card.astro'
import Intro from '../components/Intro.astro'
import SectionTitle from '../components/SectionTitle.astro'
import { getPosts, getTags } from '../lib/posts'

const posts = await getPosts()
const tags = getTags(posts)

// The wall: the three latest posts, then favorites, topped up with recent posts to fill whole rows of three.
const LATEST = 3
const latest = posts.slice(0, LATEST)
const favorites = posts.filter((p) => p.data.favorite && !latest.includes(p))
const rest = posts.filter((p) => !latest.includes(p) && !favorites.includes(p))
const picked = [...latest, ...favorites]
const wall = [...picked, ...rest.slice(0, (3 - (picked.length % 3)) % 3)]
---

<Base wide>
  <Intro />

  <div class="grid grid-flow-dense auto-rows-[15rem] grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      wall.map((p, i) => {
        // Each row of three has one large tile, alternating between the left and right side.
        const big = i % 3 === 0
        const right = big && (i / 3) % 2 === 1
        return (
          <div class:list={[big && 'sm:col-span-2 sm:row-span-2', right && 'lg:col-start-2']}>
            <Card
              post={p}
              big={big}
              eager={i === 0}
              label={i === 0 ? 'Latest' : undefined}
              sizes={big ? '(min-width: 40rem) 45rem, 100vw' : '(min-width: 40rem) 23rem, 100vw'}
            />
          </div>
        )
      })
    }
  </div>
  <div class="mt-4 text-right">
    <a href="/projects/" class="font-medium text-primary-500 hover:text-primary-400">All {posts.length} projects →</a>
  </div>

  <SectionTitle title="Browse by craft" />
  <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
    {
      tags.map((t) => (
        <a href={`/tags/${t.slug}/`} class="group relative block aspect-[4/3] overflow-hidden rounded-xl">
          <Image src={t.cover} alt="" widths={[300, 600]} sizes="(min-width: 48rem) 17rem, 50vw" class="h-full w-full object-cover brightness-50 transition duration-500 group-hover:scale-105 group-hover:brightness-75" />
          <span class="absolute inset-0 flex flex-col items-center justify-center p-2 text-center">
            <span class="text-lg font-bold sm:text-xl">{t.name}</span>
            <span class="text-sm text-gray-200">{t.count} {t.count === 1 ? 'project' : 'projects'}</span>
          </span>
        </a>
      ))
    }
  </div>
</Base>
