---
import Base from '../layouts/Base.astro'
import Card from '../components/Card.astro'
import CraftTiles from '../components/CraftTiles.astro'
import Intro from '../components/Intro.astro'
import SectionTitle from '../components/SectionTitle.astro'
import { getPosts } from '../lib/posts'

const posts = await getPosts()

// The wall: the three latest posts, then favorites, topped up with recent posts to fill whole rows of three.
const LATEST = 3
const latest = posts.slice(0, LATEST)
const favorites = posts.filter((p) => p.data.favorite && !latest.includes(p))
const rest = posts.filter((p) => !latest.includes(p) && !favorites.includes(p))
const picked = [...latest, ...favorites]
const wall = [...picked, ...rest.slice(0, (3 - (picked.length % 3)) % 3)]
---

<Base wide>
  <Intro />

  <div class="grid grid-flow-dense auto-rows-[15rem] grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      wall.map((p, i) => {
        // Each row of three has one large tile, alternating between the left and right side.
        const big = i % 3 === 0
        const right = big && (i / 3) % 2 === 1
        return (
          <div class:list={[big && 'sm:col-span-2 sm:row-span-2', right && 'lg:col-start-2']}>
            <Card
              post={p}
              big={big}
              eager={i === 0}
              label={i === 0 ? 'Latest' : undefined}
              sizes={big ? '(min-width: 40rem) 45rem, 100vw' : '(min-width: 40rem) 23rem, 100vw'}
            />
          </div>
        )
      })
    }
  </div>
  <div class="mt-4 text-right">
    <a href="/projects/" class="font-medium text-primary-500 hover:text-primary-400">All {posts.length} projects →</a>
  </div>

  <SectionTitle title="Browse by craft" />
  <CraftTiles />
</Base>
