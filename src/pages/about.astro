---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import avatar from '../assets/avatar.png'
import { site } from '../lib/posts'

const contacts = [
  { name: 'mail', label: site.email, href: `mailto:${site.email}` },
  { name: 'github', label: 'GitHub', href: site.github },
  { name: 'reddit', label: 'Reddit', href: site.reddit },
] as const
---

<Base title="About">
  <div class="mx-auto max-w-3xl pt-10">
    <div class="flex items-center gap-5">
      <Image src={avatar} alt="Portrait of Maximilian Walz" width={192} height={192} class="h-24 w-24 rounded-2xl" />
      <div>
        <h1 class="text-4xl font-extrabold tracking-tight md:text-5xl">Hi, <span class="text-primary-500">I'm Max!</span></h1>
        <p class="mt-1 text-gray-400">Software Engineer at arconsis</p>
      </div>
    </div>

    <div class="about mt-8 space-y-5 text-lg leading-8 text-gray-200">
      <p>
        Welcome to my site, where I share the stuff I create in my free time. My interests range from
        <a href="/tags/woodworking/">woodworking</a>, <a href="/tags/metalworking/">metalwork</a> and
        <a href="/tags/jewelry/">jewelry</a> to <a href="/tags/analog-photography/">analog photography</a> and
        <a href="/tags/digital-art/">digital art</a>.
      </p>
      <p>
        This site motivates me to make each project the best it can be, providing a platform to showcase my creative
        journey.
      </p>
    </div>

    <ul class="mt-10 flex flex-col gap-4 sm:flex-row sm:gap-8">
      {
        contacts.map((c) => (
          <li>
            <a href={c.href} class="flex items-center gap-2.5 text-gray-200 transition-colors hover:text-primary-400">
              <Icon name={c.name} class="h-5 w-5" />
              {c.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .about a {
    color: var(--color-primary-500);
  }
  .about a:hover {
    color: var(--color-primary-400);
  }
</style>
