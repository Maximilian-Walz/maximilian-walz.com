---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import avatar from '../assets/avatar.png'
import { site } from '../lib/posts'
---

<Base title="About">
  <div class="items-start gap-10 pt-6 md:flex">
    <div class="flex shrink-0 flex-col items-center md:w-56">
      <Image src={avatar} alt="Portrait of Maximilian Walz" width={192} height={192} class="h-48 w-48 rounded-full" />
      <h2 class="pt-4 text-2xl font-bold">{site.title}</h2>
      <p class="text-gray-400">Software Engineer</p>
      <p class="text-gray-400">arconsis</p>
    </div>
    <div class="prose prose-invert sm:prose-lg pt-8 md:pt-0">
      <h1>Hi, I'm Max!</h1>
      <p>
        Welcome to my site, where I share the stuff I create in my free time. My interests range from
        <a href="/tags/woodworking/">woodworking</a>, <a href="/tags/metalworking/">metalwork</a> and
        <a href="/tags/jewelry/">jewelry</a> to <a href="/tags/analog-photography/">analog photography</a> and
        <a href="/tags/digital-art/">digital art</a>.
      </p>
      <p>
        This site motivates me to make each project the best it can be, providing a platform to showcase my creative
        journey.
      </p>
    </div>
  </div>
</Base>
