---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import Chip from '../components/Chip.astro'
import avatar from '../assets/avatar.png'
import { getPosts, getTags, site } from '../lib/posts'
const tags = getTags(await getPosts())
---

<Base title="About">
  <div class="mx-auto max-w-3xl pt-10">
    <div class="flex items-center gap-5">
      <Image src={avatar} alt="Portrait of Maximilian Walz" width={192} height={192} class="h-24 w-24 rounded-2xl" />
      <div>
        <h1 class="text-4xl font-extrabold tracking-tight md:text-5xl">Hi, <span class="text-primary-500">I'm Max!</span></h1>
        <p class="mt-1 text-gray-400">Software Engineer at arconsis</p>
      </div>
    </div>

    <div class="mt-8 space-y-5 text-lg leading-8 text-gray-200">
      <p>
        Welcome to my site, where I share the stuff I create in my free time. My interests range from woodworking,
        metalwork and jewelry to analog photography and digital art.
      </p>
      <p>
        This site motivates me to make each project the best it can be, providing a platform to showcase my creative
        journey.
      </p>
    </div>

    <h2 class="mt-12 text-sm font-semibold tracking-widest text-gray-400 uppercase">What I make</h2>
    <div class="mt-4 flex flex-wrap gap-2">
      {tags.map((t) => <Chip href={`/tags/${t.slug}/`} count={t.count}>{t.name}</Chip>)}
    </div>

    <h2 class="mt-12 text-sm font-semibold tracking-widest text-gray-400 uppercase">Get in touch</h2>
    <div class="mt-4 flex flex-wrap gap-2">
      <Chip href={`mailto:${site.email}`}>{site.email}</Chip>
      <Chip href={site.github}>GitHub</Chip>
      <Chip href={site.reddit}>Reddit</Chip>
    </div>
  </div>
</Base>
