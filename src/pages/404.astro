---
import Base from '../layouts/Base.astro'
---

<Base title="Page not found">
  <div class="py-24 text-center">
    <h1 class="text-6xl font-extrabold text-primary-500">404</h1>
    <p class="mt-4 text-xl text-gray-200">This page does not exist.</p>
    <a href="/projects/" class="mt-6 inline-block font-medium text-primary-500 hover:text-primary-400">See all projects →</a>
  </div>
</Base>
