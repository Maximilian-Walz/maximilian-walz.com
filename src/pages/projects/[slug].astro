---
import { getImage, Image } from 'astro:assets'
import { render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import Tag from '../../components/Tag.astro'
import { formatDate, getPosts, site } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }))
}
const { post, newer, older } = Astro.props
const { Content } = await render(post)
const og = await getImage({ src: post.cover, width: 1200, height: 630, format: 'jpg', fit: 'cover' })
const glow = await getImage({ src: post.cover, width: 64, format: 'webp' })
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  datePublished: post.data.date.toISOString(),
  description: post.data.summary,
  image: new URL(og.src, Astro.site).href,
  author: { '@type': 'Person', name: site.title, url: Astro.site },
}
---

<Base title={post.data.title} description={post.data.summary} image={og.src}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <article>
    <div class="relative aspect-[2/1] w-full">
      <img class="glow" src={glow.src} alt="" aria-hidden="true" />
      <Image
        src={post.cover}
        alt={post.data.title}
        widths={[640, 960, 1280, 1920]}
        sizes="(min-width: 64rem) 61rem, 100vw"
        loading="eager"
        fetchpriority="high"
        class="hero relative h-full w-full cursor-zoom-in rounded-xl object-cover"
        style={`view-transition-name: cover-${post.id}`}
      />
    </div>
    <header class="mx-auto max-w-2xl pt-10">
      <h1 class="text-4xl font-extrabold tracking-tight text-balance md:text-5xl">{post.data.title}</h1>
      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-gray-400">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {post.data.tags.map((t) => <Tag name={t} />)}
      </div>
    </header>
    <div class="prose prose-invert sm:prose-lg py-8">
      <Content />
    </div>
    <nav aria-label="More projects" class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        [{ p: older, label: '← Older' }, { p: newer, label: 'Newer →' }].map(({ p, label }, i) =>
          p ? (
            <a href={`/projects/${p.id}/`} class:list={['group flex items-center gap-4 rounded-xl border border-gray-800 p-3 transition-colors hover:border-primary-600', i === 1 && 'sm:flex-row-reverse sm:text-right']}>
              <Image src={p.cover} alt="" width={160} height={160} fit="cover" class="h-16 w-16 shrink-0 rounded-lg object-cover" />
              <span>
                <span class="block text-sm text-gray-400">{label}</span>
                <span class="font-semibold group-hover:text-primary-400">{p.data.title}</span>
              </span>
            </a>
          ) : (
            <span class="hidden sm:block" />
          ),
        )
      }
    </nav>
  </article>
  <dialog class="lightbox" aria-label="Enlarged image"><img alt="" /></dialog>
</Base>

<style>
  /* Ambient glow: a small copy of the cover, heavily blurred, spilling out behind the hero. */
  .glow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(48px) saturate(1.6);
    opacity: 0.45;
    transform: translateY(1.25rem) scale(0.96);
  }
</style>

<script>
  // Lightbox: click an image in the post to view it full screen; arrows or swipe to move between images.
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox')!
  const view = dialog.querySelector('img')!
  const images = [...document.querySelectorAll<HTMLImageElement>('img.hero, .prose figure img')]
  let index = 0

  function show(i: number) {
    index = (i + images.length) % images.length
    const img = images[index]
    view.srcset = img.srcset
    view.sizes = '100vw'
    view.src = img.currentSrc || img.src
    view.alt = img.alt
  }
  images.forEach((img, i) =>
    img.addEventListener('click', () => {
      show(i)
      dialog.showModal()
    }),
  )
  dialog.addEventListener('click', () => dialog.close())
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(index + 1)
    if (e.key === 'ArrowLeft') show(index - 1)
  })
  let startX = 0
  dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true })
  dialog.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX
    if (Math.abs(dx) > 50) {
      e.preventDefault()
      show(index + (dx < 0 ? 1 : -1))
    }
  })
</script>
