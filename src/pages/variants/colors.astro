---
// Colour options for review. Picking one applies it to the whole site in this browser until "Current" is chosen again.
// Delete this page, the palette script in Base.astro and the [data-palette] rules in global.css once decided.
import Base from '../../layouts/Base.astro'
const palettes = [
  { id: '', name: 'Current', note: 'Your green on cool near-black.' },
  { id: 'warm', name: 'Warm', note: 'Same green, on warm brown-black neutrals. Sits better next to wood and metal.' },
  { id: 'bright', name: 'Bright', note: 'A brighter, fresher version of your green for links and tags.' },
  { id: 'moss', name: 'Moss', note: 'A calmer, more natural green on warm neutrals.' },
  { id: 'amber', name: 'Amber', note: 'No green: a warm amber accent on warm neutrals.' },
]
---

<Base title="Colour options">
  <h1 class="pt-6 text-4xl font-extrabold tracking-tight">Colour options</h1>
  <p class="mt-2 max-w-2xl text-gray-300">Pick one, then browse the site as usual: it stays applied in this browser. The logo keeps its own colours.</p>
  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    {
      palettes.map((p) => (
        <button data-pick={p.id} class="cursor-pointer rounded-xl border border-gray-700 p-4 text-left hover:border-primary-500">
          <span class="block text-xl font-bold">{p.name}</span>
          <span class="mt-1 block text-gray-300">{p.note}</span>
        </button>
      ))
    }
  </div>
  <p class="mt-8"><a href="/" class="font-medium text-primary-500 hover:text-primary-400">Go to the homepage →</a></p>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((b) =>
    b.addEventListener('click', () => {
      const id = b.dataset.pick!
      if (id) localStorage.setItem('palette', id)
      else localStorage.removeItem('palette')
      document.documentElement.dataset.palette = id
    }),
  )
</script>
