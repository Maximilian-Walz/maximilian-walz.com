---
// Logo comparison for review. Delete this page once a logo is chosen.
import Base from '../../layouts/Base.astro'
import current from '../../assets/logo.svg?raw'
import a from '../../assets/logo-a.svg?raw'
import b from '../../assets/logo-b.svg?raw'
import c from '../../assets/logo-c.svg?raw'
const sizes = ['w-40', 'w-20', 'w-10', 'w-6']
---

<Base title="Logo comparison" wide>
  <div class="grid gap-12 py-10 sm:grid-cols-2 lg:grid-cols-4">
    {
      [['Current', current], ['A: rounded M', a], ['B: lowercase m', b], ['C: badge', c]].map(([name, svg]) => (
        <section>
          <h2 class="mb-6 text-2xl font-bold">{name}</h2>
          <div class="flex flex-col gap-8">
            {sizes.map((s) => <div class:list={['logo', s]} set:html={svg} />)}
            <div class="flex items-center gap-3"><span class="logo w-9" set:html={svg} /><span class="text-xl font-semibold">Maximilian Walz</span></div>
          </div>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .logo :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
