---
import Base from '../../layouts/Base.astro'
import CraftTiles from '../../components/CraftTiles.astro'
import YearGrid from '../../components/YearGrid.astro'
import { getPosts, getTags, tagSlug } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPosts()
  return getTags(posts).map((tag) => ({
    params: { tag: tag.slug },
    props: { tag, posts: posts.filter((p) => p.data.tags.some((t) => tagSlug(t) === tag.slug)) },
  }))
}
const { tag, posts } = Astro.props
---

<Base wide title={tag.name} description={`My ${tag.name.toLowerCase()} projects.`}>
  <h1 class="pt-6 pb-6 text-4xl font-extrabold tracking-tight md:text-5xl">Projects</h1>
  <CraftTiles filter active={tag.slug} />
  <YearGrid posts={posts} />
</Base>
