---
import Base from '../../layouts/Base.astro'
import PostGrid from '../../components/PostGrid.astro'
import TagBar from '../../components/TagBar.astro'
import { getPosts, getTags, tagSlug } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPosts()
  return getTags(posts).map((tag) => ({
    params: { tag: tag.slug },
    props: { tag, posts: posts.filter((p) => p.data.tags.some((t) => tagSlug(t) === tag.slug)) },
  }))
}
const { tag, posts } = Astro.props
---

<Base wide title={tag.name} description={`My ${tag.name.toLowerCase()} projects.`}>
  <h1 class="pt-6 text-4xl font-extrabold tracking-tight md:text-5xl">{tag.name}</h1>
  <p class="mt-2 text-lg text-gray-400">{tag.count} {tag.count === 1 ? 'project' : 'projects'}</p>
  <TagBar active={tag.slug} />
  <PostGrid posts={posts} />
</Base>
